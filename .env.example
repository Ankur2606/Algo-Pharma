# ─────────────────────────────────────────────────────────────
#  AlgoPharma — Environment Configuration Template
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── App Mode ─────────────────────────────────────────────────
# Set FAST_MODE=true to skip heavy HuggingFace model loading
# (uses VADER + spaCy only). Useful for demos with slow machines.
FAST_MODE=false

# ── Database ─────────────────────────────────────────────────
# Default: local SQLite (zero setup, works out of the box)
DATABASE_URL=sqlite:///./db/algopharma.db

# ── Redis / Celery Broker ─────────────────────────────────────
# We use Upstash Redis for cloud/production message brokering.
# Create a free database at https://console.upstash.com/
# Important: ensure the URL starts with rediss:// for TLS support.
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379?ssl_cert_reqs=required

# ── Security ─────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32
SECRET_KEY=dev-secret-change-in-production

# ── Existing Demo Data Files ──────────────────────────────────
# Pre-seeded JSON crawl results for offline demo
REDDIT_JSON_PATH=data/reddit_dolo365_results.json
TWITTER_JSON_PATH=data/twitter_dolo365_results.json

# ── Reddit API (PRAW) ─────────────────────────────────────────
# Only needed if using live Reddit crawling via PRAW.
# The default crawler uses the public JSON API (no key required).
REDDIT_USER_AGENT=AlgoPharma/1.0
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# ── Twitter / X (twitterapi.io) ───────────────────────────────
# Docs: https://docs.twitterapi.io
# Provided by hackathon organizers or sign up for a free tier key.
TWITTER_API_KEY=

# ── Firecrawl ─────────────────────────────────────────────────
# Free tier (no credit card): https://firecrawl.dev
FIRECRAWL_API_KEY=

# ── Apify ─────────────────────────────────────────────────────
# For alternative scraping if needed
APIFY_TOKEN=

# ── Google Gemini ─────────────────────────────────────────────
# Get free key: https://aistudio.google.com/
GEMINI_API_KEY=

# ── Groq (PRIMARY LLM for Agentic Tool Calling) ───────────────
# REQUIRED for the main chat → crawler pipeline.
# Get free key: https://console.groq.com/
GROQ_API_KEY=

# ── Nvidia Nemotron (Slot Filler) ─────────────────────────────
# Get key: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ── Sarvam AI (Indic Translation) ────────────────────────────
# Translates Hindi / Tamil / Telugu posts to English.
# Get free key: https://dashboard.sarvam.ai/
SARVAM_API_KEY=
